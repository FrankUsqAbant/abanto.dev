ask","label":"umask","c":"permissions","r":5,"col":8,"d":"Máscara de permisos","doc":"https://man7.org/linux/man-pages/man2/umask.2.html","syn":"umask 022"},{"n":29,"s":"Su","k":"sudo","name":"sudo","label":"sudo","c":"permissions","r":6,"col":8,"d":"Ejecuta como superusuario","doc":"https://man7.org/linux/man-pages/man8/sudo.8.html","syn":"sudo command"},{"n":30,"s":"Ps","k":"ps","name":"ps","label":"ps","c":"process_mgmt","r":4,"col":9,"d":"Lista procesos activos","doc":"https://man7.org/linux/man-pages/man1/ps.1.html","syn":"ps aux"},{"n":31,"s":"Ki","k":"kill","name":"kill","label":"kill","c":"process_mgmt","r":5,"col":9,"d":"Termina proceso por PID","doc":"https://man7.org/linux/man-pages/man1/kill.1.html","syn":"kill -9 PID"},{"n":32,"s":"Pk","k":"pkill","name":"pkill","label":"pkill","c":"process_mgmt","r":6,"col":9,"d":"Termina proceso por nombre","doc":"https://man7.org/linux/man-pages/man1/pkill.1.html","syn":"pkill process_name"},{"n":33,"s":"Bg","k":"bg","name":"bg","label":"bg","c":"process_mgmt","r":4,"col":10,"d":"Proceso en background","doc":"https://man7.org/linux/man-pages/man1/bg.1p.html","syn":"bg %1"},{"n":34,"s":"Fg","k":"fg","name":"fg","label":"fg","c":"process_mgmt","r":5,"col":10,"d":"Proceso en foreground","doc":"https://man7.org/linux/man-pages/man1/fg.1p.html","syn":"fg %1"},{"n":35,"s":"Jo","k":"jobs","name":"jobs","label":"jobs","c":"process_mgmt","r":6,"col":10,"d":"Lista trabajos activos","doc":"https://man7.org/linux/man-pages/man1/jobs.1p.html","syn":"jobs"},{"n":36,"s":"No","k":"nohup","name":"nohup","label":"nohup","c":"process_mgmt","r":2,"col":11,"d":"Ejecuta sin hangup","doc":"https://man7.org/linux/man-pages/man1/nohup.1.html","syn":"nohup command &"},{"n":37,"s":"Pi","k":"ping","name":"ping","label":"ping","c":"network","r":3,"col":11,"d":"Prueba conectividad de red","doc":"https://man7.org/linux/man-pages/man8/ping.8.html","syn":"ping google.com"},{"n":38,"s":"Cr","k":"curl","name":"curl","label":"curl","c":"network","r":4,